// ==UserScript==
// @name         Sarathi Panel Copy Screenshot
// @match        https://sarathi.parivahan.gov.in/sarathiservice/examselectaction.do*
// @run-at       document-end
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const timer = setInterval(() => {
        const iframe = document.querySelector('#stallexam');
        const doc = iframe?.contentDocument;
        const panel = doc?.querySelector('#show_result')?.closest('.panel-body');

        if (!panel || doc.querySelector('#copySSBtn')) return;

        clearInterval(timer);

        const script = doc.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
        doc.head.appendChild(script);

        const btn = doc.createElement('button');
        btn.id = 'copySSBtn';
        btn.innerText = '📋 Copy Screenshot';
        btn.style.cssText = `
            position:fixed!important;
            top:15px!important;
            right:15px!important;
            z-index:2147483647!important;
            display:block!important;
            padding:12px 18px!important;
            background:#28a745!important;
            color:white!important;
            border:0!important;
            border-radius:6px!important;
            font-weight:bold!important;
            cursor:pointer!important;
        `;

        btn.onclick = async () => {
            try {
                btn.innerText = 'Copying...';

                while (!doc.defaultView.html2canvas) {
                    await new Promise(r => setTimeout(r, 200));
                }

                const canvas = await doc.defaultView.html2canvas(panel, {
                    scale: 2,
                    useCORS: true,
                    backgroundColor: '#ffffff'
                });

                const blob = await new Promise(resolve =>
                    canvas.toBlob(resolve, 'image/png')
                );

                await navigator.clipboard.write([
                    new ClipboardItem({ 'image/png': blob })
                ]);

                btn.innerText = '✅ Copied';
            } catch (error) {
                console.error(error);
                btn.innerText = '❌ Failed';
            }

            setTimeout(() => {
                btn.innerText = '📋 Copy Screenshot';
            }, 1500);
        };

        doc.body.appendChild(btn);
    }, 1000);
})();
